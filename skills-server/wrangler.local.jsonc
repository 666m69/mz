{
  // Local development only. This UUID is deliberately unbound to a Cloudflare database.
  "name": "mzcode-skills-local",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./admin", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{
    "binding":"SKILLS_DB", "database_name":"mzcode-skills-local",
    "database_id":"00000000-0000-0000-0000-000000000000", "migrations_dir":"migrations"
  }]
}
